# Copy these into Vercel Dashboard -> Project -> Settings -> Environment Variables
# (কখনোই এই file-এ আসল secret বসিয়ে git-এ push করবা না)

# Bot-এর সাথে shared secret (দুই জায়গায় SAME হতে হবে: Vercel + test bot)
WEBHOOK_SECRET=change-this-to-a-long-random-string

# Bot-এর webhook receiver URL (cloudflared দিয়ে local bot expose করার পর পাবা)
# Example: https://abc-def-123.trycloudflare.com/fuhx-webhook
BOT_WEBHOOK_URL=

# --- Permanent storage (optional কিন্তু strongly recommended) ---
# Vercel-এর local file redeploy/instance recycle-এ মুছে যায়।
# Upstash Redis (Vercel Marketplace -> Add Integration -> Upstash, free tier)
# add করলেই এই দুইটা env auto বসে যাবে:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
